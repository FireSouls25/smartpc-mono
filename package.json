{
  "name": "smart-pc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/electron-dev.mjs",
    "dev:clean": "node scripts/kill-strays.mjs",
    "electron": "electron .",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test --grep-invert @slow",
    "test:e2e:all": "playwright test",
    "test:e2e:pi": "SIDECAR_PORT=18082 APP_PORT=5200 playwright test layout.spec.ts -g \"real send\"",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:unit",
    "preview": "vite preview"
  },
  "dependencies": {
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "electron": "^44.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
