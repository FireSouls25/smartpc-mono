# Browser-only dev (Electron injects the real sidecar url + token itself).
# Run the sidecar manually: cargo run --manifest-path src/native/Cargo.toml --
#   --port 18080 --token dev-token-min-16-chars --db /tmp/dev.db
VITE_API_URL=http://127.0.0.1:18080
VITE_SIDECAR_TOKEN=dev-token-min-16-chars

# ---------------------------------------------------------------------------
# Supabase (accounts + cloud history). Read by the SIDECAR, never by the
# renderer: the renderer has no supabase client and receives no key.
# Unset (or SMARTPC_CLOUD=0) → the app is local-only, exactly as before.
#   docs/08-supabase-cloud.md has the setup; the keys are in the dashboard
#   under Project Settings → API.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://mgnlftlzmfchhbodcvmc.supabase.co
# Publishable key (sb_publishable_…) or the legacy anon key. Safe to ship:
# RLS is what protects the rows, and every request carries the user's token.
SUPABASE_ANON_KEY=
# Optional. ONLY needed so "Delete account" also removes the Supabase Auth
# user. Never commit it; leave unset and account deletion stays local.
SUPABASE_SERVICE_ROLE_KEY=
# Escape hatch for tests and offline work: force the cloud off.
# SMARTPC_CLOUD=0
